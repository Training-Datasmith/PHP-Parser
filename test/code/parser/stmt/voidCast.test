Void cast
-----
<?php
(void)foo();
( VOID ) foo();
(void)$a or $b;

// This is explicitly allowed.
for ((void)a(); $b; (void)$c) {
}

// PHP does not allow this, but the parser accepts it.
$x = (void) $y;
