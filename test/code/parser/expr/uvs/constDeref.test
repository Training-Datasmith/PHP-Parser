Dereferencing of constants
-----
<?php

A->length;
A->length();
A[0];
A[0][1][2];

A::B[0];
A::B[0][1][2];
A::B->length;
A::B->length();
A::B::C;
A::B::$c;
A::B::c();

__FUNCTION__[0];
__FUNCTION__->length;
__FUNCIONT__->length();
